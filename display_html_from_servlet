/* servlet code to render html page  and place it below src/main/java/com/example */
import java.io.IOException;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.RequestDispatcher;

@WebServlet("/display")
public class DisplayHtmlServlet extends HttpServlet {
    protected void doGet(HttpServletRequest request, HttpServletResponse response) 
            throws ServletException, IOException {
        
        // Specify the path to your HTML file relative to the web root
        RequestDispatcher dispatcher = request.getRequestDispatcher("index.html");
        
        // Forward the request and response to the HTML page
        dispatcher.forward(request, response);
    }
}


/* build the application */
mvn clean package


/* deploy your application to tomcat server. the war is located in target 
directory */

sudo cp target/htmlapp.war /var/lib/tomcat10/webapps
sudo systemctl restart tomcat10

