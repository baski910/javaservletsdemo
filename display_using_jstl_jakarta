/* servlet code */
/* create a file named DisplayArrayServlet.java with following code and place it under
   src/main/java/com/example */
import java.io.IOException;
import jakarta.servlet.RequestDispatcher;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

@WebServlet("/DisplayArrayServlet")
public class DisplayArrayServlet extends HttpServlet {
    protected void doGet(HttpServletRequest request, HttpServletResponse response) 
            throws ServletException, IOException {
        
        // Define the array
        String[] frameworkArray = {"Spring Boot", "Hibernate", "Struts", "JSF"};
        
        // Pass the array to the request scope
        request.setAttribute("frameworks", frameworkArray);
        
        // Forward the request to the JSP page
        RequestDispatcher rd = request.getRequestDispatcher("/display.jsp");
        rd.forward(request, response);
    }
}



/* jsp page */
/* create a file named display.jsp with the following code and place it under src/main/webapp */
<%@ page isELIgnored="false" %>
<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%-- 1. Import the JSTL Core Tag Library --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<html>
<head>
    <title>Display Array Using JSTL</title>
</head>
<body>

    <h2>Java Frameworks List</h2>
    <ul>
        <%-- 2. Iterate over the array --%>
        <c:forEach var="framework" items="${frameworks}">
            <li>
                <%-- 3. Print the current element safely --%>
                <c:out value="${framework}" />
            </li>
        </c:forEach>
    </ul>

</body>
</html>