import java.io.IOException;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.RequestDispatcher;

@WebServlet("/showStaticPage")
public class StaticPageServlet extends HttpServlet {
    protected void doGet(HttpServletRequest request, HttpServletResponse response) 
            throws ServletException, IOException {
        
        // Specify the path to your static HTML file
        RequestDispatcher dispatcher = request.getRequestDispatcher("/index.html");
        
        // Forward the request and response to the HTML file
        dispatcher.forward(request, response);
    }
}


/* create a separate file named StaticPageServlet.java below
src/main/java/com/example */

import java.io.IOException;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.RequestDispatcher;

@WebServlet("/SubmitServlet")
public class SubmitServlet extends HttpServlet {
    
    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response) 
            throws ServletException, IOException {
        
        // 1. Extract values sent from index.html
        String username = request.getParameter("username");
        String email = request.getParameter("email");
        
        // 2. Set them as attributes to pass to the next page
        request.setAttribute("userAttr", username);
        request.setAttribute("emailAttr", email);
        
        // 3. Forward the request internally to the display page
        RequestDispatcher dispatcher = request.getRequestDispatcher("display.jsp");
        dispatcher.forward(request, response);
    }
}


